# FRONTEND VITE (valores públicos, incluídos no build do navegador):
VITE_CONVEX_URL=

# Definido automaticamente pelo comando "bunx convex dev":
CONVEX_DEPLOYMENT=

# Configurar EXCLUSIVAMENTE no dashboard/CLI do deployment Convex,
# NUNCA dentro de .env.example, .env.local versionado ou com prefixo VITE_:
# RESEND_API_KEY
# RESEND_FROM_EMAIL = Barber OS <acesso@dominio-verificado.com.br>
# SITE_URL = https://dominio-do-frontend.pages.dev
# JWT_PRIVATE_KEY = (chave privada PKCS#8 do Convex Auth)
# JWKS = (conjunto JWK público correspondente)
#
# CONVEX_SITE_URL é automaticamente fornecido pelo Convex e NÃO é a URL do frontend.
# RESEND_API_URL só pode ser definida no Convex local para o teste E2E.
