# Frontend da homologação (valores públicos no build do Cloudflare Pages).
# Configure no Cloudflare Pages; estes valores são EXEMPLOS e não são uma configuração real.
VITE_CONVEX_URL=
VITE_STAGING_ONLY=true
# Experimento desativado por padrao
VITE_AUTH_V2_ENABLED=false
VITE_GOOGLE_AUTH_ENABLED=false

# Criado/gerido pelo CLI Convex no ambiente local; NÃO commitar .env.local:
CONVEX_DEPLOYMENT=

# Somente no deployment Convex hospedado, NUNCA no Pages ou no GitHub:
# RESEND_API_KEY        <- chave da conta Resend
# RESEND_FROM_EMAIL     <- Barber OS <onboarding@resend.dev>
# BARBER_STAGING_EMAIL  <- e-mail do titular da conta Resend (allowlist obrigatória)
# JWT_PRIVATE_KEY       <- chave privada Convex Auth
# JWKS                  <- conjunto de chaves públicas
# SITE_URL              <- https://nome-do-site.pages.dev (URL final fornecida pelo Pages)
#
# IMPORTANTE: RESEND_API_URL é somente para o fake Resend local em testes automatizados.
# CONVEX_SITE_URL (fornecida pelo Convex) não é SITE_URL nem VITE_CONVEX_URL.

# Variaveis SOMENTE no backend Convex (nao colocar no Pages):
# BARBER_AUTH_V2_ENABLED=true (habilita senha)
# BARBER_GOOGLE_AUTH_ENABLED=true (habilita Google)
# AUTH_GOOGLE_ID=ID do OAuth client Google
# AUTH_GOOGLE_SECRET=segredo OAuth Google
# BARBER_AUTH_COMMERCIAL_ENABLED=false (nao abrir cadastro nesta fase)
