# Frontend da homologação (valores públicos no build do Cloudflare Pages).
# Configure no Cloudflare Pages; estes valores são EXEMPLOS e não são uma configuração real.
VITE_CONVEX_URL=
VITE_STAGING_ONLY=true
# Experimento desativado por padrao
VITE_AUTH_V2_ENABLED=false
VITE_GOOGLE_AUTH_ENABLED=false

# Criado/gerido pelo CLI Convex no ambiente local; NÃO commitar .env.local:
CONVEX_DEPLOYMENT=

# Somente no deployment Convex hospedado, NUNCA no Pages ou no GitHub:
# RESEND_API_KEY        <- chave da conta Resend
# RESEND_FROM_EMAIL     <- Barber OS <onboarding@resend.dev>
# BARBER_STAGING_EMAIL  <- e-mail do titular da conta Resend (allowlist obrigatória)
# JWT_PRIVATE_KEY       <- chave privada Convex Auth
# JWKS                  <- conjunto de chaves públicas
# SITE_URL              <- https://nome-do-site.pages.dev (URL final fornecida pelo Pages)
#
# Barber OS Admin v1: variáveis PRIVADAS somente no deployment Convex, desabilitado por padrão:
# BARBER_PLATFORM_ADMIN_USER_ID <- ID real da conta verificada em Data > users > _id
# BARBER_PLATFORM_ADMIN_EMAIL   <- e-mail verificado correspondente à mesma conta
# NÃO configurar essas variáveis no Cloudflare Pages. Nunca usar IDs de outra conta.
# IMPORTANTE: RESEND_API_URL é somente para o fake Resend local em testes automatizados.
# CONVEX_SITE_URL (fornecida pelo Convex) não é SITE_URL nem VITE_CONVEX_URL.

# Variaveis SOMENTE no backend Convex (nao colocar no Pages):
# BARBER_AUTH_V2_ENABLED=true (habilita senha)
# BARBER_GOOGLE_AUTH_ENABLED=true (habilita Google)
# AUTH_GOOGLE_ID=ID do OAuth client Google
# AUTH_GOOGLE_SECRET=segredo OAuth Google
# BARBER_AUTH_COMMERCIAL_ENABLED=false (nao abrir cadastro nesta fase)


# Asaas: inbox de eventos SANDBOX, estritamente backend e DESATIVADA por padrão.
# Não colocar no Cloudflare ou em VITE_* e NÃO commitar segredos.
# BARBER_ASAAS_ENV=sandbox
# BARBER_ASAAS_WEBHOOK_ENABLED=false
# BARBER_ASAAS_WEBHOOK_TOKEN=  <- gerar valor aleatório privado, 32 a 255 chars
# URL webhook no Asaas Sandbox: CONVEX_SITE_URL + /integrations/asaas/webhook
# Nunca confundir o authToken do webhook com a chave da API do Asaas.


# Asaas Sandbox: consulta pontual do status, desativada por padrão:
# BARBER_ASAAS_API_KEY=        <- somente API key Sandbox em variáveis privadas Convex
# BARBER_ASAAS_LOOKUP_ENABLED=false
# A API key NÃO é BARBER_ASAAS_WEBHOOK_TOKEN e nunca deve ir para VITE_*/Cloudflare.

# Propostas manuais de associação cobrança ↔ unidade (exclusivamente Sandbox, desabilitado)
# BARBER_ASAAS_LINKING_ENABLED=false
# Nunca habilitar em produção. Associação não concede acesso nem reconhece receita.
